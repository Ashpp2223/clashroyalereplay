{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "皇室战争复盘器",
  "version": "0.3.10",
  "identifier": "local.clash-replay-tree",
  "build": {
    "beforeDevCommand": "npm.cmd run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "皇室战争复盘器",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/native-bridge/": "native-bridge/"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "targets": "nsis",
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/branding.nsh"
      },
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "wix/zh-CN.wxl"
          }
        }
      }
    }
  }
}
