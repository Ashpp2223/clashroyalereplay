{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "皇室战争局面树复盘器",
  "version": "0.1.0",
  "identifier": "local.clash-replay-tree",
  "build": {
    "beforeDevCommand": "npm.cmd run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "皇室战争局面树复盘器",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": "msi",
    "useLocalToolsDir": true,
    "windows": {
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "wix/zh-CN.wxl"
          }
        }
      }
    }
  }
}
