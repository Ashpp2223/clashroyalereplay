{
  "name": "clash-replay-tree",
  "version": "0.3.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "web:dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:domain": "node tests/domain.test.mjs",
    "test:native": "node --test tests/nativeReplay.test.mjs tests/nativeGeometry.test.mjs tests/nativeJournal.test.mjs tests/nativeUx.test.mjs && python -m unittest discover -s bridge -p test_*.py",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:frontend": "node scripts/verify_native_frontend.mjs",
    "test:native-ux": "node scripts/verify_native_ux.mjs",
    "test:desktop": "node scripts/verify_desktop_app.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.64.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
